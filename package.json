{
  "name": "moyo-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "cms": "node scripts/copy-cms.mjs",
    "dev": "npm run cms && astro dev",
    "build": "npm run cms && astro build",
    "build:preview": "npm run cms && PUBLIC_PREVIEW=true astro build --outDir dist-preview && node scripts/relativize.mjs dist-preview",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^5",
    "@astrojs/sitemap": "^3.7.5",
    "sharp": "^0.35.5",
    "lenis": "^1.3.27",
    "@sveltia/cms": "^0.268.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0"
  }
}
