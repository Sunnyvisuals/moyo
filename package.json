{
  "name": "moyo",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "description": "Site du studio moyo sur Cloudflare Pages : la page d'accueil, tous les projets par catégorie, un mode admin.",
  "scripts": {
    "postinstall": "node scripts/ci-worker.mjs",
    "build": "node build.mjs",
    "dev": "node build.mjs && wrangler pages dev",
    "deploy": "node build.mjs && wrangler pages deploy"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "wrangler": "^4.166.0"
  }
}
