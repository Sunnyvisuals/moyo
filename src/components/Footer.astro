---
import { type Lang, type RouteKey, type T, routes, ui } from '../i18n/ui';
import { getSettings } from '../lib/content';
interface Props { lang: Lang; alternates: T }
const { lang } = Astro.props;
const s = await getSettings();
const nav: RouteKey[] = ['projects', 'services', 'studio', 'contact'];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__cols">
    <p class="t-md" style="max-width: 22em">{ui('footer.line', lang)}</p>
    <div>
      <h2>{ui('footer.studio', lang)}</h2>
      <ul>{nav.map((k) => <li><a class="link" href={routes[k][lang]}>{ui(`nav.${k}`, lang)}</a></li>)}</ul>
    </div>
    <div>
      <h2>{ui('footer.follow', lang)}</h2>
      <ul>{s.socials.map((so) => <li><a class="link" href={so.url} rel="noopener" target="_blank">{so.label}</a></li>)}</ul>
    </div>
    <div>
      <h2>{ui('footer.write', lang)}</h2>
      <ul>
        <li><a class="link" href={`mailto:${s.email}`}>{s.email}</a></li>
        <li class="muted">{s.region[lang]}</li>
        <li class="muted">{s.coordinates}</li>
      </ul>
    </div>
  </div>
  <p class="footer__mark wordmark" aria-hidden="true">moyo</p>
  <div class="footer__bottom">
    <span>© {year} moyo. {ui('footer.rights', lang)}.</span>
    <nav aria-label="Informations légales">
      <a class="link" href={routes.legal[lang]}>{lang === 'fr' ? 'Mentions légales' : 'Legal notice'}</a>
      <a class="link" href={routes.privacy[lang]}>{lang === 'fr' ? 'Confidentialité' : 'Privacy'}</a>
    </nav>
  </div>
</footer>
