---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { type Lang, projectUrl, ui } from '../i18n/ui';
interface Props { p: CollectionEntry<'projects'>; lang: Lang; sectorTitles: Record<string, string>; serviceTitles: Record<string, string>; eager?: boolean }
const { p, lang, sectorTitles, serviceTitles, eager } = Astro.props;
const d = p.data;
const sectors = d.sectors.map((s) => s.id);
const disc = d.disciplines.map((s) => s.id);
---
<a class="card" href={projectUrl(p.id, lang)} data-card data-sectors={sectors.join(' ')} data-disciplines={disc.join(' ')} data-cursor={ui('view', lang)}>
  <div class="card__media">
    <Image src={d.cover} alt={d.coverAlt[lang]} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 50vw" quality={72} loading={eager ? 'eager' : 'lazy'} style={`view-transition-name: vt-${p.id}`} />
  </div>
  <div class="card__head">
    <h2 class="card__title">{d.title}</h2>
    <span class="card__year">{d.year}</span>
  </div>
  <div class="card__tags">
    {sectors.map((s) => <span class="tag">{sectorTitles[s]}</span>)}
    {disc.slice(0, 2).map((s) => <span class="tag">{serviceTitles[s]}</span>)}
    {d.placeholder && <span class="tag tag--sample">{ui('sample', lang)}</span>}
  </div>
</a>
