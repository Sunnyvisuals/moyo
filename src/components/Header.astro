---
import { type Lang, type RouteKey, type T, routes, ui } from '../i18n/ui';
import { getSettings } from '../lib/content';
interface Props { lang: Lang; current?: RouteKey; alternates: T }
const { lang, current, alternates } = Astro.props;
const s = await getSettings();
const nav: RouteKey[] = ['projects', 'services', 'studio', 'contact'];
const talk = lang === 'fr' ? 'Parlons-en' : "Let's talk";
---
<header class="header" data-header>
  <div class="header__col header__brand">
    <a href={routes.home[lang]} class="header__logo wordmark" aria-label="moyo, accueil">moyo</a>
    <span class="label">{s.region[lang]}</span>
  </div>
  <div class="header__col header__status label">
    {s.availability && <span>{s.availability[lang]}</span>}
    <span>{ui('localTime', lang)} <time data-clock>--:--</time></span>
  </div>
  <nav class="header__col header__nav label" aria-label="Navigation principale">
    {nav.map((k) => (
      <a class="roll" href={routes[k][lang]} aria-current={current === k ? 'page' : undefined}><span data-t={ui(`nav.${k}`, lang)}>{ui(`nav.${k}`, lang)}</span></a>
    ))}
  </nav>
  <div class="header__col header__tools label">
    <a class="roll" href={routes.contact[lang]}><span data-t={talk}>{talk}</span></a>
    <span class="lang">
      <a href={alternates.fr} hreflang="fr" lang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>FR</a>
      <span aria-hidden="true">/</span>
      <a href={alternates.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
    </span>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={ui('themeToggle', lang)}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" /><path d="M8 1a7 7 0 0 1 0 14z" fill="currentColor" /></svg>
    </button>
  </div>
  <button class="menu-btn label" type="button" data-menu aria-expanded="false" aria-controls="mobile-nav">{ui('menu', lang)}</button>
</header>
<div class="mobile-nav" id="mobile-nav" data-mobile-nav>
  <ul>
    <li><a href={routes.home[lang]}><span class="wordmark">moyo</span></a></li>
    {nav.map((k) => <li><a href={routes[k][lang]}>{ui(`nav.${k}`, lang)}</a></li>)}
  </ul>
  <div class="label mobile-nav__foot">
    <span class="lang">
      <a href={alternates.fr} hreflang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>Français</a>
      &nbsp;/&nbsp;
      <a href={alternates.en} hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a>
    </span>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={ui('themeToggle', lang)}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" /><path d="M8 1a7 7 0 0 1 0 14z" fill="currentColor" /></svg>
    </button>
  </div>
</div>
