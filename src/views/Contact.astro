---
import Base from '../layouts/Base.astro';
import { type Lang, routes, ui } from '../i18n/ui';
import { getPage, getSectors, getServices, getSettings } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const [page, settings, sectors, services] = await Promise.all([getPage('contact'), getSettings(), getSectors(), getServices()]);
const preview = import.meta.env.PUBLIC_PREVIEW === 'true';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
const f = (k: string) => ui(`form.${k}`, lang);
---
<Base lang={lang} current="contact" alternates={routes.contact} title={ui('nav.contact', lang)} description={page.text[lang]}>
  <section class="page-head wrap grid contact" style="padding-inline:var(--gutter)">
    <div class="contact__intro">
      <h1>{page.title[lang]}</h1>
      <p class="muted">{page.text[lang]}</p>
      <div class="contact__direct">
        <span class="muted">{f('direct')}</span>
        <a class="link" href={`mailto:${settings.email}`} style="justify-self:start">{settings.email}</a>
        {settings.phone && <a class="link" href={`tel:${settings.phone.replace(/\s/g, '')}`} style="justify-self:start">{settings.phone}</a>}
        <span class="muted">{settings.region[lang]}</span>
      </div>
    </div>
    <form class="form" method="post" action="/api/contact" novalidate data-contact-form data-preview={preview ? 'true' : undefined}
      data-msg-sending={f('sending')} data-msg-sent={f('sent')} data-msg-failed={`${f('failed')} ${settings.email}.`}
      data-msg-required={f('required')} data-msg-email={f('invalidEmail')} data-msg-consent={f('consentRequired')} data-msg-preview={f('preview')}>
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="t" value="" data-started />
      <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <div class="field">
        <label for="f-name">{f('name')}</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name" />
        <span class="field__error" id="e-name"></span>
      </div>
      <div class="field">
        <label for="f-email">{f('email')}</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="e-email" />
        <span class="field__error" id="e-email"></span>
      </div>
      <div class="field">
        <label for="f-company">{f('company')}</label>
        <input id="f-company" name="company" type="text" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="f-sector">{f('sector')}</label>
        <select id="f-sector" name="sector">
          <option value="">{f('choose')}</option>
          {sectors.map((s) => <option value={s.id}>{s.data.title[lang]}</option>)}
          <option value="autre">{f('sectorOther')}</option>
        </select>
      </div>
      <fieldset class="field">
        <legend>{f('needs')}</legend>
        <div class="chips">
          {services.map((s) => <><input type="checkbox" id={`n-${s.id}`} name="needs" value={s.id} /><label for={`n-${s.id}`}>{s.data.title[lang]}</label></>)}
        </div>
      </fieldset>
      <div class="field">
        <label for="f-message">{f('message')}</label>
        <textarea id="f-message" name="message" required aria-describedby="e-message"></textarea>
        <span class="field__error" id="e-message"></span>
      </div>
      <div>
        <label class="consent"><input type="checkbox" name="consent" value="1" required aria-describedby="e-consent" /> <span>{f('consent')} <a class="link" href={routes.privacy[lang]}>{f('privacy')}</a>.</span></label>
        <span class="field__error" id="e-consent"></span>
      </div>
      {!preview && <div class="cf-turnstile" data-sitekey={siteKey} data-language={lang} data-theme="auto"></div>}
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem">
        <button class="btn" type="submit"><span class="dot"></span>{f('send')}</button>
        <p class="form__status" role="status" data-status></p>
      </div>
    </form>
  </section>
  {!preview && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>
