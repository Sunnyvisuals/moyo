---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { type Lang, routes, ui } from '../i18n/ui';
import { getPage, getPartners, getTeam, initials } from '../lib/content';
import studioImg from '../assets/uploads/studio-0.jpg';
interface Props { lang: Lang }
const { lang } = Astro.props;
const [page, team, partners] = await Promise.all([getPage('studio'), getTeam(), getPartners()]);
const clients = partners.filter((p) => p.data.kind === 'client');
const network = partners.filter((p) => p.data.kind === 'partner');
---
<Base lang={lang} current="studio" alternates={routes.studio} title={page.title[lang]} description={page.lead[lang]}>
  <header class="page-head">
    <h1>{page.title[lang]}</h1>
    <p class="lede">{page.lead[lang]}</p>
  </header>
  <section class="wrap grid story">
    <figure class="story__media" data-reveal><Image src={studioImg} alt={lang === 'fr' ? 'Lumière de persiennes dans le studio' : 'Shutter light in the studio'} widths={[600, 1000]} sizes="(max-width:860px) 100vw, 40vw" /></figure>
    <div class="story__text">{page.story[lang].split(/\n\s*\n/).map((p: string) => <p>{p}</p>)}</div>
  </section>
  <section class="section wrap" aria-labelledby="values-title">
    <h2 id="values-title" class="t-xl">{page.values.title[lang]}</h2>
    <div class="values">
      {page.values.items.map((v: any) => <div><h3>{v.title[lang]}</h3><p>{v.text[lang]}</p></div>)}
    </div>
  </section>
  <section class="wrap" aria-labelledby="team-title" style="padding-bottom:var(--section)">
    <h2 id="team-title" class="t-xl">{page.team.title[lang]}</h2>
    <ul class="team">
      {team.map((m) => (
        <li>
          <div class="member__mono" aria-hidden="true">{initials(m.data.name)}</div>
          <p class="member__name">{m.data.name}</p>
          <p class="member__role">{m.data.role[lang]}</p>
          {m.data.placeholder && <span class="tag tag--sample" style="margin-top:.6rem">{ui('sample', lang)}</span>}
        </li>
      ))}
    </ul>
  </section>
  <section class="wrap network" aria-labelledby="network-title" style="padding-bottom:var(--section)">
    <div class="network__text">
      <h2 id="network-title" class="t-xl">{page.network.title[lang]}</h2>
      <p class="muted" style="margin-top:1.5rem;max-width:28em">{page.network.text[lang]}</p>
    </div>
    <div class="network__lists">
      <div><h3>{lang === 'fr' ? 'Partenaires' : 'Partners'}</h3><ul>{network.map((p) => <li><span>{p.data.name}</span><span>{p.data.field[lang]}</span></li>)}</ul></div>
      <div><h3>{lang === 'fr' ? 'Clients' : 'Clients'}</h3><ul>{clients.map((p) => <li><span>{p.data.name}</span><span>{p.data.field[lang]}</span></li>)}</ul></div>
    </div>
  </section>
</Base>
