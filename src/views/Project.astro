---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { type Lang, projectUrl, routes, ui } from '../i18n/ui';
import { getProjects, getSectors, getServices } from '../lib/content';
interface Props { lang: Lang; project: CollectionEntry<'projects'> }
const { lang, project } = Astro.props;
const d = project.data;
const [all, services, sectors] = await Promise.all([getProjects(), getServices(), getSectors()]);
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];
const sector = sectors.find((s) => s.id === d.sectors[0].id)!;
const sectorNames = d.sectors.map((s) => sectors.find((x) => x.id === s.id)?.data.title[lang]).join(', ');
const discs = d.disciplines.map((s) => services.find((x) => x.id === s.id)).filter(Boolean);
const paras = (s: string) => s.split(/\n\s*\n/);
const alternates = { fr: projectUrl(project.id, 'fr'), en: projectUrl(project.id, 'en') };
const jsonld = {
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: d.title, dateCreated: String(d.year),
  creator: { '@type': 'Organization', name: 'moyo' }, about: d.summary[lang], locationCreated: d.location[lang],
};
---
<Base lang={lang} current="projects" alternates={alternates} title={d.title} description={d.summary[lang]} sector={sector.data.theme} jsonld={jsonld}>
  <header class="case-head">
    <h1>{d.title}</h1>
    {d.placeholder && <p style="margin-top:1.25rem"><span class="tag tag--sample">{ui('sample', lang)}</span></p>}
    <dl class="case-head__meta">
      <div><dt>{ui('case.client', lang)}</dt><dd>{d.client}</dd></div>
      <div><dt>{ui('case.year', lang)}, {ui('case.location', lang).toLowerCase()}</dt><dd>{d.year}, {d.location[lang]}</dd></div>
      <div><dt>{ui('case.sector', lang)}</dt><dd><a class="link" href={`${routes.projects[lang]}?s=${d.sectors[0].id}`}>{sectorNames}</a></dd></div>
      <div><dt>{ui('case.disciplines', lang)}</dt><dd>{discs.map((s, i) => <>{i > 0 && ', '}<a class="link" href={`${routes.services[lang]}#${s!.id}`}>{s!.data.title[lang]}</a></>)}</dd></div>
    </dl>
  </header>
  <div class="case-cover">
    <Image src={d.cover} alt={d.coverAlt[lang]} widths={[800, 1400, 1800]} quality={68} sizes="100vw" loading="eager" fetchpriority="high" style={`view-transition-name: vt-${project.id}`} />
  </div>
  <section class="section wrap">
    <p class="case-summary">{d.summary[lang]}</p>
  </section>
  <section class="wrap case-blocks" style="padding-bottom:var(--section)">
    {d.blocks.map((b) => {
      if (b.type === 'text') return (
        <div class="b-text">
          <h2>{b.title?.[lang]}</h2>
          <div class="prose">{paras(b.body[lang]).map((p) => <p>{p}</p>)}</div>
        </div>
      );
      if (b.type === 'quote') return (
        <blockquote class="b-quote"><p>« {b.body[lang]} »</p>{b.author && <footer>{b.author}</footer>}</blockquote>
      );
      if (b.type === 'image') return (
        <figure class:list={['b-image', b.layout === 'inset' && 'b-image--inset']} data-reveal>
          <Image src={b.src} alt={b.alt[lang]} widths={[800, 1400, 1800]} quality={68} sizes="100vw" />
        </figure>
      );
      if (b.type === 'diptych') return (
        <div class="b-diptych">
          <figure data-reveal><Image src={b.left} alt={b.alt[lang]} widths={[600, 1000]} sizes="(max-width:760px) 100vw, 50vw" /></figure>
          <figure data-reveal><Image src={b.right} alt={b.alt[lang]} widths={[600, 1000]} sizes="(max-width:760px) 100vw, 50vw" /></figure>
        </div>
      );
      if (b.type === 'video') return (
        <figure class="b-video"><video src={b.url} controls playsinline preload="metadata" />{b.caption?.[lang] && <figcaption>{b.caption[lang]}</figcaption>}</figure>
      );
    })}
    {d.credits.length > 0 && (
      <div>
        <h2 class="t-lg" style="margin-bottom:1.5rem">{ui('case.credits', lang)}</h2>
        <dl class="credits">{d.credits.map((c) => <div><dt>{c.role[lang]}</dt><dd>{c.name}</dd></div>)}</dl>
      </div>
    )}
  </section>
  <a class="next" href={projectUrl(next.id, lang)} data-cursor={ui('view', lang)}>
    <Image src={next.data.cover} alt="" widths={[800, 1600]} quality={68} sizes="100vw" />
    <span class="next__label">{ui('case.next', lang)}</span>
    <span class="next__title display">{next.data.title}</span>
  </a>
</Base>
