---
import Base from '../layouts/Base.astro';
import { type Lang, routes } from '../i18n/ui';
import { getPage, miniMarkdown } from '../lib/content';
interface Props { lang: Lang; id: 'legal' | 'privacy' }
const { lang, id } = Astro.props;
const page = await getPage(id);
const date = new Date(page.updated).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base lang={lang} alternates={routes[id]} title={page.title[lang]}>
  <header class="page-head">
    <h1>{page.title[lang]}</h1>
    <p class="muted" style="margin-top:1.5rem">{lang === 'fr' ? 'Mise à jour le' : 'Updated'} {date}</p>
  </header>
  <article class="wrap legal" style="padding-bottom:var(--section)" set:html={miniMarkdown(page.body[lang])} />
</Base>
