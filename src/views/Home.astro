---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { type Lang, projectUrl, routes } from '../i18n/ui';
import { getPage, getProjects, getSectors, getServices, getSettings } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const [page, settings, projects, sectors, services] = await Promise.all([getPage('home'), getSettings(), getProjects(), getSectors(), getServices()]);
const sectorTitle = Object.fromEntries(sectors.map((s) => [s.id, s.data.title[lang]]));
const serviceTitle = Object.fromEntries(services.map((s) => [s.id, s.data.title[lang]]));
// « moyo » reste toujours en minuscules, même dans un texte en capitales
const intro = (page.intro[lang] as string).split(/(moyo)/);
---
<Base lang={lang} current="home" alternates={routes.home} bare>
  <section class="stage" data-stage aria-label={lang === 'fr' ? 'Projets' : 'Work'}>
    <h1 class="sr-only">moyo, {page.hero.line[lang]}</h1>
    <canvas class="stage__gl" data-ribbon-canvas aria-hidden="true"></canvas>
    <ul class="ribbon" data-ribbon data-view={page.ribbon.view[lang]}>
      {projects.map((p, i) => (
        <li class="ribbon__item">
          <a href={projectUrl(p.id, lang)} data-title={p.data.title} data-meta={`${serviceTitle[p.data.disciplines[0].id]}, ${sectorTitle[p.data.sectors[0].id]}, ${p.data.year}`}>
            <Image src={p.data.cover} alt={p.data.coverAlt[lang]} width={1024} quality={72} loading={i < 3 ? 'eager' : 'lazy'} />
            <span class="ribbon__title label">{p.data.title}</span>
            <span class="ribbon__meta label">{serviceTitle[p.data.disciplines[0].id]}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="stage__caption label" aria-hidden="true"><span data-caption-title>{projects[0].data.title}</span><span data-caption-meta class="muted"></span></p>
    <p class="stage__hint label muted" aria-hidden="true">{page.ribbon.hint[lang]}</p>
    <div class="stage__bottom">
      <p class="stage__intro">{intro.map((part) => (part === 'moyo' ? <span class="nocase">moyo</span> : part))}</p>
      <ul class="stage__social label">
        {settings.socials.map((so) => <li><a class="roll" href={so.url} rel="noopener" target="_blank"><span data-t={so.label}>{so.label}</span></a></li>)}
      </ul>
      <p class="stage__contact label">
        <a class="roll" href={`mailto:${settings.email}`}><span data-t={settings.email}>{settings.email}</span></a>
        {settings.phone && <a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a>}
        <a class="roll" href={routes.legal[lang]}><span data-t={lang === 'fr' ? 'Mentions légales' : 'Legal notice'}>{lang === 'fr' ? 'Mentions légales' : 'Legal notice'}</span></a>
      </p>
    </div>
  </section>
</Base>
