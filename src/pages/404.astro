---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { routes } from '../i18n/ui';
import { getPage, getSettings } from '../lib/content';
const page = await getPage('notfound');
const s = await getSettings();
---
<Base lang="fr" alternates={routes.home} title="404">
  <div class="lost">
    <Hero lang="fr" mark="404" line={`${page.title.fr} ${page.title.en}`} region={s.region.fr} coordinates={s.coordinates} focus={0.15} tag="p" />
  </div>
  <section class="section wrap">
    <h1 class="t-xl">{page.title.fr}</h1>
    <p class="lede muted" style="margin-top:1rem">{page.text.fr}</p>
    <p class="lede muted" lang="en" style="margin-top:.5rem">{page.text.en}</p>
    <div class="cta__row">
      <a class="btn" href={routes.home.fr}><span class="dot"></span>Retour à l'accueil</a>
      <a class="btn btn--ghost" href={routes.projects.fr}>Voir les projets</a>
    </div>
  </section>
</Base>
